{
  "name": "intelligent-organization",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "db:up": "node scripts/database.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/api.mjs",
    "dev:desktop": "pnpm --filter @io/desktop tauri dev",
    "build": "pnpm -r --if-present build",
    "build:app": "pnpm --filter @io/desktop tauri build --bundles app",
    "check": "pnpm -r --if-present typecheck",
    "test:api": "node scripts/test-api.mjs",
    "test:flow": "node scripts/verify-flow.mjs",
    "seed": "node scripts/seed.mjs",
    "setup:local": "node scripts/setup.mjs",
    "format": "prettier --write \"apps/desktop/src/**/*.{ts,tsx,css}\" \"plugins/*/src/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"apps/desktop/src/**/*.{ts,tsx,css}\" \"plugins/*/src/**/*.ts\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
